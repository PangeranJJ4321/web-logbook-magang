generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String         @id @default(uuid())
  email                    String         @unique
  passwordHash             String
  fullName                 String
  createdAt                DateTime       @default(now())
  targetHours              Float          @default(900.0)
  internshipStart          DateTime       @default(dbgenerated("'2026-05-20 00:00:00'::timestamp without time zone"))
  internshipEnd            DateTime       @default(dbgenerated("'2026-09-20 23:59:59.999'::timestamp without time zone"))
  emailVerified            Boolean        @default(false)
  verificationToken        String?        @unique
  verificationTokenExpires DateTime?
  sendReminders            Boolean        @default(true)
  logEntries               LogEntry[]
  weeklyReviews            WeeklyReview[]
}

model LogEntry {
  id            String   @id @default(uuid())
  userId        String
  title         String
  date          DateTime
  startTime     String
  endTime       String
  durationHours Float
  category      String
  details       String
  documentation String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeeklyReview {
  id          String   @id @default(uuid())
  userId      String
  weekIndex   Int
  summaryText String
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekIndex])
}
